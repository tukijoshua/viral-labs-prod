// Viral Labs Database Schema
// Uses PostgreSQL for production-grade reliability

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - synced with Clerk
model User {
  id            String   @id // Clerk user ID
  email         String   @unique
  firstName     String?
  lastName      String?
  imageUrl      String?

  // Subscription info (synced from Whop)
  subscriptionTier SubscriptionTier @default(FREE)
  whopUserId       String?          @unique
  whopMembershipId String?          @unique
  subscriptionStatus String?        @default("inactive")

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  audits        Audit[]
  usageTracking UsageTracking?

  @@index([email])
  @@index([whopUserId])
}

// Audit model - stores content analysis results
model Audit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // File info
  fileName    String
  fileType    FileType
  fileSize    Int
  fileUrl     String
  textContent String?      // For TEXT type: store content directly (no blob fetch)

  // Analysis results
  impactScore      Int?     // 0-100
  analysisStatus   String   @default("pending") // pending, processing, completed, failed

  // Core Analysis (JSON fields)
  viralTips        Json?    // Array of 3-5 specific, actionable improvements
  alternatives     Json?    // Array of alternative versions with type, explanation, risk level
  viralProtocol    Json?    // Exactly 3 steps (immediate, medium, optional)
  platformInsights Json?    // Platform-specific analysis (X/Twitter, etc.)
  growthPrediction Json?    // Current estimate, improved estimate, increase percentage

  // Content-Specific Data
  viewerInterest   Json?    // For videos: timestamps + scores array
  dropZones        Json?    // For videos: timestamp + reason objects
  auraCheck        Json?    // For images: vibe + status + score
  hookStrength     Int?     // For text: 1-10 score
  viralRewrites    Json?    // DEPRECATED: use alternatives instead

  // Raw AI response (for debugging and chat context)
  rawAnalysis      Json?

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([analysisStatus])
}

// Usage tracking for free tier limits
model UsageTracking {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditsThisMonth Int      @default(0)
  lastResetDate   DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Enums
enum SubscriptionTier {
  FREE
  PRO
  AGENCY
}

enum FileType {
  VIDEO
  IMAGE
  TEXT
}
